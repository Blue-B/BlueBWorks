name: Verify lab and projects

on:
  push:
    branches: [main, 'daily/**']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: verify-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Check out this commit
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Test the registration validator
        run: python3 -m unittest discover -s tests -v
      - name: Validate project registrations
        run: python3 automation/check.py
      - name: Run each registered project's declared checks
        run: python3 automation/check.py --run
